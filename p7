(3, 4, 'Ravi', '2024-01-15', NULL);
-- 1. INNER JOIN: Show only issued books
SELECT b.book_id, b.title, i.member_name, i.issue_date
FROM Books b
INNER JOIN Issue i ON b.book_id = i.book_id;
-- 2. LEFT JOIN: All books with issue details (NULL if not issued)
SELECT b.book_id, b.title, i.member_name, i.issue_date
FROM Books b
LEFT JOIN Issue i ON b.book_id = i.book_id;
-- 3. RIGHT JOIN: All issued records with book details
SELECT b.title, i.issue_id, i.member_name, i.issue_date
FROM Books b
RIGHT JOIN Issue i ON b.book_id = i.book_id;
-- Create VIEW for currently issued books (return_date IS NULL)
CREATE VIEW CurrentlyIssued AS
SELECT b.title, i.member_name, i.issue_date
FROM Books b
INNER JOIN Issue i ON b.book_id = i.book_id
WHERE i.return_date IS NULL;
-- Query the view
SELECT * FROM CurrentlyIssued;
