PRACTICAL 7 — JOIN Operations & Views: Library Management
```sql
-- Create Tables
CREATE TABLE Books (
book_id INT PRIMARY KEY,
title VARCHAR(100) NOT NULL,
author VARCHAR(50)
);
CREATE TABLE Issue (
issue_id INT PRIMARY KEY,
book_id INT,
member_name VARCHAR(50),
issue_date DATE,
return_date DATE,
FOREIGN KEY (book_id) REFERENCES Books(book_id)
);
-- Insert Records
INSERT INTO Books VALUES
(1, 'DBMS Concepts', 'Korth'),
(2, 'Operating Systems', 'Silberschatz'),
(3, 'Data Structures', 'Tanenbaum'),
(4, 'Computer Networks', 'Forouzan'),
(5, 'Algorithms', 'Cormen');
INSERT INTO Issue VALUES
(1, 1, 'Amit', '2024-01-10', '2024-01-20'),
